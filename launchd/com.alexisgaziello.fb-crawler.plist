<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.alexisgaziello.fb-crawler</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/pnpm</string>
    <string>--dir</string>
    <string>/Users/alexisgaziello/local/fb-crawler</string>
    <string>run</string>
    <string>scrape:daily</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/alexisgaziello/local/fb-crawler</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>3600</integer>

  <key>StandardOutPath</key>
  <string>/Users/alexisgaziello/local/fb-crawler/.data/launchd.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/alexisgaziello/local/fb-crawler/.data/launchd.stderr.log</string>
</dict>
</plist>
