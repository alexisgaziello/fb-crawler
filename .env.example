# This file defines every configuration default. Copy it to .env, then override
# only the values needed for your machine. Process environment values take
# precedence over .env. Boolean values accept true/false, 1/0, yes/no, or on/off.

# OpenAI API key used for classification. Required when scraping posts.
OPENAI_API_KEY=

# OpenAI model used to classify extracted posts.
OPENAI_MODEL=gpt-5.4-mini

# Facebook group feed to monitor. Your saved session must have access to it.
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/416383335109560

# Pipe-separated accessible labels for the group feed's sort control. Include
# the labels Facebook shows for the account's configured languages.
FACEBOOK_SORT_TRIGGER_LABELS=Más pertinentes|Actividad reciente|Nuevas publicaciones|Most relevant|Recent activity|New posts

# Pipe-separated labels for the New posts radio option itself. This is
# matched semantically so menu ordering can change safely.
FACEBOOK_NEW_POSTS_LABELS=Nuevas publicaciones|New posts

# Application log level. scrape:debug overrides this with debug for that run.
LOG_LEVEL=info

# Run Chromium headlessly. Headed and debug commands override this as needed.
HEADLESS=true

# Viewport for unattended headless runs. Headed runs use the native window size.
HEADLESS_VIEWPORT_WIDTH=1920
HEADLESS_VIEWPORT_HEIGHT=1080

# Maximum number of new posts extracted and classified in one run.
MAX_POSTS=20

# Ignore posts whose visible timestamp appears older than this many hours.
LOOKBACK_HOURS=48

# Fixed Playwright delay after each browser operation, useful for debugging.
SLOW_MO_MS=0

# Random delay range between purposeful browser actions.
ACTION_DELAY_MIN_MS=350
ACTION_DELAY_MAX_MS=1600

# Hard limit on feed advances when no earlier stop condition is reached.
SCROLL_STEPS=60

# Random wheel-distance range per feed advance. The maximum is also capped at
# 75% of the viewport height so consecutive scans overlap.
SCROLL_DISTANCE_MIN_PX=420
SCROLL_DISTANCE_PX=720

# Stop after this many already-reviewed post IDs are encountered. Set to 0 to
# disable this stop condition.
MAX_ALREADY_REVIEWED_POSTS=4

# Maximum number of classified post IDs retained locally for deduplication.
ANALYZED_POSTS_CACHE_LIMIT=1000

# Buyer height supplied to the classifier.
BUYER_HEIGHT_FEET=6
BUYER_HEIGHT_INCHES=3

# Minimum acceptable top-of-range harness fit height, in centimeters. A harness
# whose stated fit range tops out below this is treated as too small and
# rejected outright; between this and the buyer's height it surfaces only as a
# possible_match flagged as likely short.
MIN_HARNESS_HEIGHT_CM=184

# Target main size used for container compatibility, plus the acceptable
# inclusive size range for mains already included with complete rigs.
TARGET_CANOPY_SIZE=170
MIN_CANOPY_SIZE=160
MAX_CANOPY_SIZE=180

# SMTP server settings for email alerts. Email is enabled only when SMTP_HOST
# and EMAIL_TO are set; authentication is used only when both user and password
# are set. EMAIL_FROM falls back to SMTP_USER, then fb-crawler@localhost.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# Send macOS desktop notifications for matches and operational alerts.
NOTIFY_DESKTOP=false
