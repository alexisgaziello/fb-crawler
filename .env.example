# Required for classification.
OPENAI_API_KEY=

# Defaults to a low-cost current model. Override if you prefer another model.
OPENAI_MODEL=gpt-5.4-mini

# Facebook group to monitor.
FACEBOOK_GROUP_URL=https://www.facebook.com/groups/416383335109560

# Browser/session/state.
LOG_LEVEL=info
HEADLESS=true
MAX_POSTS=25
LOOKBACK_HOURS=48
SLOW_MO_MS=0
ACTION_DELAY_MIN_MS=350
ACTION_DELAY_MAX_MS=1600
REVIEWED_POST_LIMIT=1000

# Your search preferences.
BUYER_HEIGHT_FEET=6
BUYER_HEIGHT_INCHES=3
TARGET_CANOPY_SIZE=170
MIN_CANOPY_SIZE=160
MAX_CANOPY_SIZE=180

# Email notification, optional. If unset, matches are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=

# macOS desktop notification, optional.
NOTIFY_DESKTOP=false
